{
  "name": "employee-evaluation-system",
  "version": "1.0.0",
  "private": false,
  "homepage": "https://jhonkayleeroisa.github.io/employee-evaluation-system",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "deploy": "cd client && npm run build && gh-pages -d build",
    "db:init": "node server/db/init.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.4",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "gh-pages": "^6.1.1",
    "nodemon": "^3.1.4"
  }
}
